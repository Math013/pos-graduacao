# Python / Data Science .gitignore

# Ambientes virtuais
.venv/
venv/
env/
ENV/
.env

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
*.pdb
*.pkl
*.log

# IDEs
.vscode/
.idea/

# Jupyter
.ipynb_checkpoints/
*copy*.ipynb

# R
.Rhistory
.RData

# OS
.DS_Store
Thumbs.db

# Artefatos temporários
*.bak
*.swp

# Bancos locais
*.db

# Mídia e arquivos de curso (vídeos e zips são grandes demais para o git)
*.mp4
*.zip

# Arquivos grandes (>100MB — limite do GitHub)
Modelos-Regressao/dados/Motor_Vehicle_Collisions.csv
Modelos-Regressao/dados/sisvan_estado_nutricional_2023.csv
Modelos-Regressao/dados/covid_doencas_preexistentes.csv
Modelos-Regressao/dados/SPDadosCriminais_2025.xlsx
Modelos-Regressao/projeto_final/Motor_Vehicle_Collisions.csv
Modelos-Regressao/aulas/04 - Regressão Binária com Python.ipynb

# Análise de Sobrevivência - bases do RHC (grandes demais para o GitHub)
Analise-Sobrevivencia/ProjetoFinal/*.DBF
Analise-Sobrevivencia/ProjetoFinal/*.zip
Analise-Sobrevivencia/ProjetoFinal/*.rds

# LaTeX - arquivos temporários
*.aux
*.toc
*.synctex(busy)
*.synctex.gz
